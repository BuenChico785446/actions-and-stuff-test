{
  "schemaVersion": 1,
  "id": "bedrockmotion",
  "version": "${version}",
  "name": "BedrockMotion",
  "description": "Brings Bedrock animations (Molang, animation controllers, render controllers, client entities) to Java Edition.",
  "authors": ["BedrockMotion"],
  "license": "MIT",
  "icon": "assets/bedrockmotion/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.bedrockmotion.client.BedrockMotionClient"],
    "modmenu": ["dev.bedrockmotion.client.config.ModMenuIntegration"]
  },
  "mixins": ["bedrockmotion.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "cloth-config": "*",
    "minecraft": "~26.3",
    "java": ">=25"
  },
  "suggests": {
    "modmenu": "*"
  }
}
